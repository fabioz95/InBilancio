rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Spazio dati effettivo di un utente: il proprio uid, oppure l'uid
    // dell'account a cui si è collegato (vedi users/{uid}.dataOwnerUid).
    function dataOwnerOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.dataOwnerUid;
    }

    match /users/{uid} {
      // Leggibile da se stessi e da chiunque condivida lo stesso spazio dati
      // (serve per mostrare nome/foto degli account collegati in Impostazioni).
      allow read: if request.auth != null
        && (request.auth.uid == uid || dataOwnerOf(request.auth.uid) == dataOwnerOf(uid));

      // Alla creazione si è sempre proprietari dei propri dati.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.dataOwnerUid == uid;

      // Solo il proprietario del documento può scriverlo, in uno di questi casi:
      //  1) aggiornamento "normale" (profilo/impostazioni) che non tocca dataOwnerUid
      //  2) si torna a essere proprietari dei propri dati (scollegamento)
      //  3) ci si collega allo spazio dati di un altro account tramite un
      //     codice invito valido e non scaduto indirizzato a quell'account
      allow update: if request.auth != null && request.auth.uid == uid && (
        request.resource.data.dataOwnerUid == resource.data.dataOwnerUid ||
        request.resource.data.dataOwnerUid == uid ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dataOwnerUid', 'lastInviteCode']) &&
          exists(/databases/$(database)/documents/linkCodes/$(request.resource.data.lastInviteCode)) &&
          get(/databases/$(database)/documents/linkCodes/$(request.resource.data.lastInviteCode)).data.ownerUid == request.resource.data.dataOwnerUid &&
          get(/databases/$(database)/documents/linkCodes/$(request.resource.data.lastInviteCode)).data.expiresAt > request.time
        )
      );

      allow delete: if false;

      // Conti, categorie, transazioni, grafici, ricorrenze: accessibili da se
      // stessi e da tutti gli account collegati allo stesso spazio dati.
      match /{collection}/{docId} {
        allow read, write: if request.auth != null
          && (request.auth.uid == uid || dataOwnerOf(request.auth.uid) == uid);
      }
    }

    // Codici invito per collegare due account: leggibili per codice esatto
    // (mai elencabili, per evitare di indovinarli scorrendo la lista) da
    // chiunque sia autenticato; creabili solo per il proprio spazio dati.
    match /linkCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == dataOwnerOf(request.auth.uid);
      allow delete: if request.auth != null;
      allow update: if false;
    }
  }
}
